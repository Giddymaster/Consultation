{
  "name": "meridian-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm --filter @meridian/api dev",
    "dev:web": "pnpm --filter @meridian/web dev",
    "build": "pnpm --filter @meridian/types build && pnpm --filter @meridian/api build && pnpm --filter @meridian/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @meridian/api db:generate",
    "db:migrate": "pnpm --filter @meridian/api db:migrate",
    "db:deploy": "pnpm --filter @meridian/api db:deploy",
    "db:seed": "pnpm --filter @meridian/api db:seed",
    "db:reset": "pnpm --filter @meridian/api db:reset",
    "db:studio": "pnpm --filter @meridian/api db:studio",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@babel/eslint-parser": "8.0.1",
    "@babel/preset-react": "8.0.1",
    "@babel/preset-typescript": "8.0.1",
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "typescript": "7.0.2"
  }
}
