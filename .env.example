# =============================================================================
# Meridian Advisory — environment template
#
# Copy to `apps/api/.env` (backend) and `apps/web/.env` (frontend, VITE_* only).
# Never commit a filled-in copy: real credentials belong in your host's secret
# store, not in the repository.
# =============================================================================

# --- Core -------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Public origin of the web client. Used for links in emails and for CORS.
APP_URL=http://localhost:5173
# Public origin of this API. Used for OAuth redirect URIs and webhook URLs.
API_URL=http://localhost:4000

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meridian?schema=public

# --- Auth -------------------------------------------------------------------
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
# Access tokens are short-lived; refresh tokens rotate on every use.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# AES-256-GCM key for OAuth tokens and integration credentials at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
COOKIE_DOMAIN=
# Set true behind HTTPS in production so the refresh cookie is Secure.
COOKIE_SECURE=false

# --- Business defaults ------------------------------------------------------
BUSINESS_NAME=Meridian Advisory
BUSINESS_TIMEZONE=Africa/Nairobi
BUSINESS_CURRENCY=KES
SUPPORT_EMAIL=support@meridianadvisory.co.ke
SUPPORT_PHONE=+254 20 000 0000

# --- Paystack ---------------------------------------------------------------
# The secret key must never reach the browser. Only the public key is exposed,
# and only through GET /api/settings/public.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
# Webhook endpoint to register in the Paystack dashboard:
#   {API_URL}/api/webhooks/paystack

# --- Google (Calendar + Meet) ----------------------------------------------
# Redirect URI: {API_URL}/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Microsoft (Outlook Calendar + Teams) ----------------------------------
# Redirect URI: {API_URL}/api/integrations/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# --- Zoom -------------------------------------------------------------------
# Server-to-Server OAuth app (account credentials grant).
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_ACCOUNT_ID=

# --- Email ------------------------------------------------------------------
# EMAIL_PROVIDER: smtp | resend | console
EMAIL_PROVIDER=console
EMAIL_FROM="Meridian Advisory <no-reply@meridianadvisory.co.ke>"
EMAIL_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# --- Storage (S3-compatible) ------------------------------------------------
# STORAGE_DRIVER: s3 | local
STORAGE_DRIVER=local
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=meridian-private
STORAGE_PUBLIC_BUCKET=meridian-public
# Seconds a signed download URL stays valid.
STORAGE_SIGNED_URL_TTL=300
# Local driver only: directory for uploads when STORAGE_DRIVER=local.
STORAGE_LOCAL_PATH=./storage

# --- Development mocks ------------------------------------------------------
# Each mock is refused at boot when NODE_ENV=production, so a stray `true`
# cannot silently fake a payment or a meeting link in a live deployment.
MOCK_PAYMENTS=false
MOCK_VIDEO=false
MOCK_EMAIL=true
MOCK_CALENDAR=false

# --- Operations -------------------------------------------------------------
LOG_LEVEL=info
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW=1 minute
# Runs the background job worker inside the API process. Set false when running
# `pnpm --filter @meridian/api jobs` as a separate worker dyno.
RUN_JOBS_IN_PROCESS=true
