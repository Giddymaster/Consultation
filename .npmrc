auto-install-peers=true
strict-peer-dependencies=false

# These four packages legitimately need a postinstall step: argon2 compiles a
# native addon, esbuild and the Prisma packages fetch or generate platform
# binaries. Every other package's install scripts stay blocked.
only-built-dependencies[]=@prisma/engines
only-built-dependencies[]=argon2
only-built-dependencies[]=esbuild
only-built-dependencies[]=prisma
